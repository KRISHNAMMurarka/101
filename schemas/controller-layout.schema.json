{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://101.local/schemas/controller-layout.schema.json",
  "title": "101 Link Controller Layout",
  "type": "object",
  "additionalProperties": false,
  "required": ["layout"],
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string", "minLength": 1, "maxLength": 64 },
    "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "motion": {
      "type": "object", "additionalProperties": false, "required": ["action", "mode"],
      "properties": {
        "action": { "$ref": "#/$defs/action" }, "mode": { "enum": ["tilt", "wand"] }, "label": { "type": "string", "minLength": 1, "maxLength": 64 },
        "gestures": { "type": "object", "additionalProperties": false, "properties": { "shake": { "$ref": "#/$defs/action" }, "swing": { "$ref": "#/$defs/action" }, "spin": { "$ref": "#/$defs/action" } } }
      }
    },
    "layout": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/element" } }
  },
  "$defs": {
    "action": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][A-Za-z0-9]*(?:[._-][A-Za-z0-9]+)*$" },
    "element": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type", "action"], "properties": { "type": { "enum": ["joystick", "dpad", "touch-surface"] }, "action": { "$ref": "#/$defs/action" }, "label": { "type": "string", "minLength": 1, "maxLength": 64 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "action", "label"], "properties": { "type": { "const": "button" }, "action": { "$ref": "#/$defs/action" }, "label": { "type": "string", "minLength": 1, "maxLength": 64 }, "emphasis": { "enum": ["normal", "primary", "danger"] } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "action", "label"], "properties": { "type": { "const": "slider" }, "action": { "$ref": "#/$defs/action" }, "label": { "type": "string", "minLength": 1, "maxLength": 64 }, "min": { "type": "number", "minimum": -1, "maximum": 1 }, "max": { "type": "number", "minimum": -1, "maximum": 1 }, "step": { "type": "number", "exclusiveMinimum": 0, "maximum": 2 } } }
      ]
    }
  }
}
