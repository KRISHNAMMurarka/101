{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:101:device-descriptor:1",
  "title": "101 device descriptor",
  "description": "Inert device capabilities. A descriptor is descriptive data and never supplies authentication or an operation grant.",
  "x-runtime-validation": {
    "descriptorMaxUtf8Bytes": 65536,
    "jsonMaxDepth": 8,
    "valueSchemaJsonMaxDepth": 10,
    "jsonMaxEntriesPerContainer": 128,
    "valueSchemaMaxDepth": 4,
    "valueSchemaMaxNodes": 256,
    "rules": [
      "finite numeric values",
      "min must be no greater than max",
      "array minItems must be no greater than maxItems",
      "record optional members must be declared fields",
      "spatial values require capability schemaVersion >= 2 recursively",
      "rich input values require capability schemaVersion >= 2, event kind and reliable delivery recursively",
      "spatial axes must be orthogonal and match declared handedness",
      "joint names, parents and optional members must be declared, unique and acyclic",
      "quaternion squared norm must be within 0.002 of 1",
      "transform mirror parity must match frame handedness",
      "value schema depth and total node limits apply recursively",
      "capability IDs must be unique",
      "metadata and extensions must be bounded immutable plain JSON data",
      "object input must have only enumerable data properties without cycles or custom prototypes"
    ]
  },
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "label",
    "revision",
    "adapter",
    "runtime",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "adapter": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*:[^\\u0000-\\u001f\\u007f]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "platform"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/definitions/capability"
      }
    },
    "metadata": {
      "$ref": "#/definitions/jsonObject"
    },
    "extensions": {
      "$ref": "#/definitions/extensions"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "jsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/definitions/jsonValue"
          }
        },
        {
          "$ref": "#/definitions/jsonObject"
        }
      ]
    },
    "jsonObject": {
      "type": "object",
      "maxProperties": 128,
      "additionalProperties": {
        "$ref": "#/definitions/jsonValue"
      }
    },
    "extensions": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z][A-Za-z0-9._-]*:[^\\u0000-\\u001f\\u007f]+$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/jsonValue"
      }
    },
    "spatialFrame": {
      "type": "object",
      "required": [
        "id",
        "origin",
        "unit",
        "axes",
        "handedness"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*:[^\\u0000-\\u001f\\u007f]+$"
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*:[^\\u0000-\\u001f\\u007f]+$"
        },
        "unit": {
          "enum": [
            "m",
            "cm",
            "mm"
          ]
        },
        "axes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "enum": [
              "right",
              "left",
              "up",
              "down",
              "forward",
              "backward"
            ]
          }
        },
        "handedness": {
          "enum": [
            "right",
            "left"
          ]
        }
      },
      "additionalProperties": false
    },
    "spatialJoint": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "not": {
            "enum": [
              "__proto__",
              "prototype",
              "constructor"
            ]
          }
        },
        "parent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "not": {
            "enum": [
              "__proto__",
              "prototype",
              "constructor"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "unit",
            "min",
            "max"
          ],
          "properties": {
            "type": {
              "const": "scalar"
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "resolution": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "frame": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "unit",
            "min",
            "max",
            "frame",
            "components"
          ],
          "properties": {
            "type": {
              "const": "vector"
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "resolution": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "frame": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "components": {
              "enum": [
                [
                  "x",
                  "y"
                ],
                [
                  "x",
                  "y",
                  "z"
                ]
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "values"
          ],
          "properties": {
            "type": {
              "const": "enum"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "$ref": "#/definitions/record"
        },
        {
          "$ref": "#/definitions/array"
        },
        {
          "type": "object",
          "required": [
            "type",
            "frame"
          ],
          "properties": {
            "type": {
              "const": "quaternion"
            },
            "frame": {
              "$ref": "#/definitions/spatialFrame"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "frame",
            "extent"
          ],
          "properties": {
            "type": {
              "const": "pose"
            },
            "frame": {
              "$ref": "#/definitions/spatialFrame"
            },
            "extent": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "frame",
            "extent",
            "joints"
          ],
          "properties": {
            "type": {
              "const": "joints"
            },
            "frame": {
              "$ref": "#/definitions/spatialFrame"
            },
            "extent": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "joints": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "$ref": "#/definitions/spatialJoint"
              }
            },
            "optional": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "not": {
                  "enum": [
                    "__proto__",
                    "prototype",
                    "constructor"
                  ]
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "from",
            "to",
            "maxTranslation"
          ],
          "properties": {
            "type": {
              "const": "transform"
            },
            "from": {
              "$ref": "#/definitions/spatialFrame"
            },
            "to": {
              "$ref": "#/definitions/spatialFrame"
            },
            "maxTranslation": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "frame"
          ],
          "properties": {
            "type": {
              "const": "contact"
            },
            "frame": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "frame"
          ],
          "properties": {
            "type": {
              "const": "pen"
            },
            "frame": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "key"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "maxLength"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "maxLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2048
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "maxDelta"
          ],
          "properties": {
            "type": {
              "const": "wheel"
            },
            "maxDelta": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "frame",
            "maxDelta"
          ],
          "properties": {
            "type": {
              "const": "relative-motion"
            },
            "frame": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "maxDelta": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "record": {
      "type": "object",
      "required": [
        "type",
        "fields"
      ],
      "properties": {
        "type": {
          "const": "record"
        },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "not": {
              "enum": [
                "__proto__",
                "prototype",
                "constructor"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/definitions/value"
          }
        },
        "optional": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "not": {
              "enum": [
                "__proto__",
                "prototype",
                "constructor"
              ]
            }
          }
        }
      },
      "additionalProperties": false
    },
    "array": {
      "type": "object",
      "required": [
        "type",
        "items",
        "minItems",
        "maxItems"
      ],
      "properties": {
        "type": {
          "const": "array"
        },
        "items": {
          "$ref": "#/definitions/value"
        },
        "minItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        }
      },
      "additionalProperties": false
    },
    "delivery": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "mode",
            "maxHz",
            "maxAgeMs"
          ],
          "properties": {
            "mode": {
              "const": "latest"
            },
            "maxHz": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "maxAgeMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "mode",
            "maxAgeMs"
          ],
          "properties": {
            "mode": {
              "const": "reliable"
            },
            "maxAgeMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ownership": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "exclusive",
                "observe"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "mode",
            "partitions"
          ],
          "properties": {
            "mode": {
              "const": "partitioned"
            },
            "partitions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "capability": {
      "type": "object",
      "required": [
        "id",
        "semantic",
        "schemaVersion",
        "kind",
        "value",
        "delivery",
        "permissions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "semantic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*:[^\\u0000-\\u001f\\u007f]+$"
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "kind": {
          "enum": [
            "sample",
            "event",
            "command",
            "property",
            "job"
          ]
        },
        "value": {
          "$ref": "#/definitions/value"
        },
        "delivery": {
          "$ref": "#/definitions/delivery"
        },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "read",
              "subscribe",
              "write",
              "invoke"
            ]
          }
        },
        "ownership": {
          "$ref": "#/definitions/ownership"
        },
        "metadata": {
          "$ref": "#/definitions/jsonObject"
        },
        "extensions": {
          "$ref": "#/definitions/extensions"
        }
      },
      "additionalProperties": false
    }
  }
}
