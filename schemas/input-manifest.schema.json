{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://101.local/schemas/input-manifest.schema.json",
  "title": "101 Semantic Input Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "game"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "game": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "actions": {
      "$ref": "#/$defs/group"
    },
    "axes": {
      "$ref": "#/$defs/group"
    },
    "vectors": {
      "$ref": "#/$defs/group"
    },
    "poses": {
      "$ref": "#/$defs/group"
    }
  },
  "$defs": {
    "source": {
      "enum": [
        "keyboard",
        "mouse",
        "touch",
        "gamepad",
        "phone-motion",
        "watch-motion",
        "camera-hand",
        "camera-pose",
        "camera-face",
        "hid",
        "bluetooth",
        "serial",
        "custom"
      ]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommended"
      ],
      "properties": {
        "recommended": {
          "type": "array",
          "minItems": 1,
          "maxItems": 14,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "fallback": {
          "type": "array",
          "maxItems": 14,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "optional": {
          "type": "boolean",
          "description": "When true, the game still runs if nothing can serve this control. Defaults to required."
        }
      }
    },
    "group": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]*(?:[._-][A-Za-z0-9]+)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/control"
      }
    }
  }
}
