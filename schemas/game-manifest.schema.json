{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://101.local/schemas/game-manifest.schema.json",
  "title": "101 Game Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "engine", "renderer", "players", "inputs", "offline", "procedural"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "tagline": { "type": "string", "minLength": 1, "maxLength": 160 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "engine": { "type": "string", "pattern": "^\\^?[0-9]+(?:\\.[0-9]+){0,2}$" },
    "renderer": { "enum": ["2d", "3d"] },
    "players": {
      "type": "object", "additionalProperties": false, "required": ["min", "max"],
      "properties": { "min": { "type": "integer", "minimum": 1, "maximum": 32 }, "max": { "type": "integer", "minimum": 1, "maximum": 32 } }
    },
    "inputs": { "$ref": "#/$defs/sources" },
    "offline": { "type": "boolean" },
    "procedural": { "type": "boolean" },
    "status": { "enum": ["playable", "foundation", "planned"] },
    "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "order": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "controllers": {
      "type": "object", "additionalProperties": false, "required": ["basic"],
      "properties": { "basic": { "$ref": "#/$defs/sources" }, "enhanced": { "$ref": "#/$defs/sources" }, "immersive": { "$ref": "#/$defs/sources" } }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "source": { "enum": ["keyboard", "mouse", "touch", "gamepad", "phone-motion", "watch-motion", "camera-hand", "camera-pose", "camera-face", "hid", "bluetooth", "serial", "custom"] },
    "sources": { "type": "array", "minItems": 1, "maxItems": 14, "uniqueItems": true, "items": { "$ref": "#/$defs/source" } }
  }
}
