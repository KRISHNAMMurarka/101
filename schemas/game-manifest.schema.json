{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://101.local/schemas/game-manifest.schema.json",
  "title": "101 Game Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "engine",
    "renderer",
    "players",
    "inputs",
    "offline",
    "procedural"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "tagline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "engine": {
      "type": "string",
      "pattern": "^\\^?[0-9]+(?:\\.[0-9]+){0,2}$"
    },
    "renderer": {
      "enum": [
        "2d",
        "3d",
        "video"
      ]
    },
    "players": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      }
    },
    "inputs": {
      "$ref": "#/$defs/sources"
    },
    "offline": {
      "type": "boolean"
    },
    "procedural": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "playable",
        "foundation",
        "planned"
      ]
    },
    "accent": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "controllers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basic"
      ],
      "properties": {
        "basic": {
          "$ref": "#/$defs/sources"
        },
        "enhanced": {
          "$ref": "#/$defs/sources"
        },
        "immersive": {
          "$ref": "#/$defs/sources"
        }
      }
    },
    "surface": {
      "description": "What this package is. A tool is built with the SDK but is not something a player browses for.",
      "enum": [
        "game",
        "tool"
      ],
      "default": "game"
    },
    "runtime": {
      "enum": [
        "local",
        "hosted",
        "streamed"
      ],
      "default": "local"
    },
    "launchUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 2048
    },
    "inputTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport",
        "endpoint",
        "format"
      ],
      "properties": {
        "transport": {
          "enum": [
            "webrtc",
            "websocket"
          ]
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "format": {
          "const": "101-json"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "transport": {
                "const": "webrtc"
              }
            }
          },
          "then": {
            "properties": {
              "endpoint": {
                "pattern": "^https?://"
              }
            }
          },
          "else": {
            "properties": {
              "endpoint": {
                "pattern": "^wss?://"
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "source": {
      "enum": [
        "keyboard",
        "mouse",
        "touch",
        "gamepad",
        "phone-motion",
        "watch-motion",
        "camera-hand",
        "camera-pose",
        "camera-face",
        "hid",
        "bluetooth",
        "serial",
        "custom"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 13,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "local"
          }
        }
      },
      "then": {
        "properties": {
          "renderer": {
            "enum": [
              "2d",
              "3d"
            ]
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "launchUrl"
              ]
            },
            {
              "required": [
                "inputTarget"
              ]
            }
          ]
        }
      }
    }
  ]
}
