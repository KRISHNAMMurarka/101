{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": [
      "vite/client"
    ],
    "incremental": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@101/core": [
        "./packages/core/src/index.ts"
      ],
      "@101/sdk": [
        "./packages/sdk/src/index.ts"
      ],
      "@101/game-registry": [
        "./packages/game-registry/src/index.ts"
      ],
      "@101/game-host": [
        "./packages/game-host/src/index.ts"
      ],
      "@101/input": [
        "./packages/input/src/index.ts"
      ],
      "@101/link-controller": [
        "./packages/link-controller/src/index.ts"
      ],
      "@101/render-2d": [
        "./packages/render-2d/src/index.ts"
      ],
      "@101/render-3d": [
        "./packages/render-3d/src/index.ts"
      ],
      "@101/physics": [
        "./packages/physics/src/index.ts"
      ],
      "@101/rhythm": [
        "./packages/rhythm/src/index.ts"
      ],
      "@101/maze": [
        "./packages/maze/src/index.ts"
      ],
      "@101/swarm": [
        "./packages/swarm/src/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "apps/controller-native",
    "release",
    "outputs"
  ]
}
