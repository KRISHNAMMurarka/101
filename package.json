{
  "name": "101-games",
  "version": "0.1.0",
  "private": true,
  "description": "Games and game controls built on Uynis Connect.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "games/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "node tools/prepare-connect-assets.mjs && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node tools/stamp-service-worker.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "serve:secure": "node tools/serve-secure.mjs",
    "test": "npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "node tools/run-unit-tests.mjs",
    "qa:layout": "node tools/qa-browser.mjs layout",
    "qa:keyboard": "node tools/qa-browser.mjs keyboard",
    "qa:growth": "node tools/qa-browser.mjs growth",
    "qa:offline": "node tools/qa-browser.mjs offline",
    "qa:engines": "node tools/qa-browser.mjs engines",
    "typecheck": "tsc --noEmit",
    "create:game": "node --experimental-strip-types tools/create-101-game.mjs",
    "schemas:sources": "node --experimental-strip-types tools/generate-input-source-schemas.mjs",
    "license:inventory": "node tools/generate-license-inventory.mjs",
    "audit:production": "node tools/audit-production.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "package:release": "node tools/package-release.mjs",
    "predev": "node tools/prepare-connect-assets.mjs && node tools/check-port.mjs",
    "prestart": "node tools/check-port.mjs",
    "phone": "node tools/lan-test.mjs"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "0.19.3",
    "@uynis-connect/connect": "file:../uynis-connect/sdk/connect",
    "phaser": "3.90.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.179.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/howler": "2.2.12",
    "@types/node": "22.19.19",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.179.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "ajv": "6.15.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "playwright": "1.61.1",
    "react-server-dom-webpack": "19.2.8",
    "source-map-js": "file:vendor/source-map-js-1.2.2+101.1.tgz",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.16",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "compression": "1.8.2",
    "fast-uri": "3.1.8",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "shell-quote": "1.11.0",
    "source-map-js": "$source-map-js",
    "vinext": {
      "image-size": "2.0.3"
    },
    "ws": "8.21.0"
  },
  "type": "module"
}
