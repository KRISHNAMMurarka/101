{
  "name": "101-platform",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first gaming runtime where almost anything can become a controller.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "games/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node tools/stamp-service-worker.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "serve:secure": "node tools/serve-secure.mjs",
    "test": "npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "node tools/run-unit-tests.mjs",
    "qa:layout": "node tools/qa-browser.mjs layout",
    "qa:keyboard": "node tools/qa-browser.mjs keyboard",
    "qa:growth": "node tools/qa-browser.mjs growth",
    "qa:offline": "node tools/qa-browser.mjs offline",
    "qa:engines": "node tools/qa-browser.mjs engines",
    "typecheck": "tsc --noEmit",
    "create:game": "node --experimental-strip-types tools/create-101-game.mjs",
    "create:device": "node --experimental-strip-types tools/create-device-project.mjs",
    "hub": "node --experimental-strip-types tools/hub-server.mjs",
    "native:start": "npm --workspace @101/controller-native run start",
    "native:android": "npm --workspace @101/controller-native run android",
    "native:ios": "npm --workspace @101/controller-native run ios",
    "native:typecheck": "npm --workspace @101/controller-native run typecheck",
    "native:test": "npm --workspace @101/controller-native test",
    "native:doctor": "npm --workspace @101/controller-native run doctor",
    "native:export": "npm --workspace @101/controller-native run export",
    "desktop:dev": "npm --workspace @101/desktop-hub run tauri:dev",
    "desktop:build": "npm --workspace @101/desktop-hub run tauri:build",
    "desktop:app": "npm --workspace @101/desktop-hub run tauri:app",
    "desktop:check": "npm --workspace @101/desktop-hub run check",
    "desktop:test": "npm --workspace @101/desktop-hub run test",
    "watch:ios:test": "cd apps/watch-ios && swift test",
    "watch:ios:check": "node tools/check-watchos-build.mjs",
    "watch:wear:test": "node tools/wear-gradle.mjs testDebugUnitTest",
    "watch:wear:build": "node tools/wear-gradle.mjs assembleDebug",
    "schemas:sources": "node --experimental-strip-types tools/generate-input-source-schemas.mjs",
    "license:inventory": "node tools/generate-license-inventory.mjs && node tools/generate-rust-license-inventory.mjs",
    "audit:production": "node tools/audit-production.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "package:release": "node tools/package-release.mjs",
    "predev": "node tools/check-port.mjs",
    "prestart": "node tools/check-port.mjs",
    "phone": "node tools/lan-test.mjs",
    "vision:models": "node tools/fetch-vision-models.mjs",
    "example:devices": "node --experimental-strip-types examples/device-pipelines/run.ts",
    "schemas:devices": "node --experimental-strip-types tools/generate-device-schema.mjs",
    "build:sdk": "node tools/build-sdk.mjs"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "0.19.3",
    "@mediapipe/tasks-vision": "1.0.1",
    "howler": "2.2.4",
    "phaser": "3.90.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.179.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/howler": "2.2.12",
    "@types/node": "22.19.19",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.179.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "ajv": "6.15.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "playwright": "1.61.1",
    "react-native": "0.86.2",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.16",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "compression": "1.8.2",
    "fast-uri": "3.1.8",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "plist": {
      "@xmldom/xmldom": "0.9.12"
    },
    "react-native": "0.86.2",
    "shell-quote": "1.11.0",
    "source-map-js": "1.2.2",
    "vinext": {
      "image-size": "2.0.3"
    },
    "ws": "8.21.0"
  },
  "type": "module"
}
