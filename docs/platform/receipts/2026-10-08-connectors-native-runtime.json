      "open": "General serial/RTU CRC and physical device profile/effect qualification."
    },
    "A05": {
      "built": "Reviewed exact-topic MQTT5 source/command provider, QoS 0/1, retained rejection, producer deduplication/original absolute expiry, immutable complete authority, raw-slot and shared teardown fencing.",
      "proof": "Eleven focused cases reported by repair author; retained independent review, and actual owned Mosquitto 2.1.2 installed-SDK caller with two effects/two duplicates and separate observed states.",
      "oldWitness": "Repair author observed five review regressions and producer/timeout failures against pinned OLD source. Exact outputs were in internal task tools, not retained files; this receipt does not fabricate literal logs.",
      "open": "Separate-process clock mapping, remote TLS/ACL qualification and physical device evidence."
    },
    "E12/K03": {
      "built": "Real macOS arm64 C own-RSS lifecycle ABI, fixed private child and Node bridge, signal-only registration/read grants, verified private executable copy, absolute native deadline and Stop settlement; exact-inventory static library archive and clean consumer.",
      "proof": "Six native C groups, fourteen source repair QA checks, actual C RSS via installed public SDK route and raw child exit.",
      "open": "Swift/Kotlin lifecycle APIs, other OSes/app installation, physical qualification and sleep/drift beyond explicit mapping bounds."
    },
    "connectorDeadline": {
      "built": "Transport write contexts carry the original absolute command deadline; cleanup checks logical and wall expiry.",
      "proof": "Retained genuine OLD regression and sixteen focused cases."
    }
