  "change": "After a valid foreground scanner generation is reserved and before requesting absent camera permission, show the existing camera-only-pairing/paste guidance. Preserve all generation/foreground fences. Retired asynchronous permission callbacks cannot open a scanner or overwrite current feedback.",
  "regression": {
    "oldPinned": "Actual old App/helper and same regression retained; first-refusal guidance assertion failed after modeled native-prompt background/foreground and denied completion.",
    "currentFocusedScannerCases": 15,
    "combinedReceiverAndScannerCases": 25,
    "harnessScope": "Actual App function extracted with TypeScript AST, React state harness and unavailable Expo permission bridge replacement. Source regression is not native acceptance.",
    "independentReview": {
      "schemaVersion": 1,
      "status": "clear",
      "scope": "Independent read-only review of the IOS-AUDIT-01 scratch guidance repair. App.tsx and scanner-session.test.ts reviewed; scanner-session.ts confirmed unchanged. No repository/native source changes or simulator claims reviewed.",
      "reviewedSha256": {
        "/tmp/101-ios-refusal-regression/App.tsx": "cdd9cf0781947dd8a5e8e2888ebce5eb8b492356ce875f4361e58a83382078db",
