{
  "schemaVersion": 1,
  "profile": "structured-telemetry-json2/1",
  "version": "1.0.0",
  "codec": "json/2",
  "lane": "disposable",
  "authority": "inert-codec-only",
  "selectedValues": [
    "app:page-reading/1",
    "app:page-reading-table/1"
  ],
  "limits": {
    "packetBytes": 4096,
    "containerDepth": 3,
    "tableRows": 8,
    "consumerCommands": 128,
    "consumerLineBytes": 16384,
    "consumerInputBytes": 1048576,
    "consumerOutputBytes": 1048576
  },
  "runtimeDependencies": {
    "swift": [
      "Foundation",
      "CoreFoundation"
    ]
  },
  "declaredTarget": "swift-macos-arm64",
  "excluded": [
    "other-json2-schemas",
    "native-runtime-lifecycle",
    "resource-grants",
    "identity",
    "transport-authentication",
    "clock-conversion",
    "physical-effects",
    "ios",
    "android",
    "kotlin",
    "c",
    "cross-toolchain-abi",
    "public-distribution"
  ]
}
