{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@101/adapter-watch": [
        "../../packages/adapter-watch/src/index.ts"
      ],
      "@101/input": [
        "../../packages/input/src/index.ts"
      ],
      "@101/link-controller": [
        "../../packages/link-controller/src/index.ts"
      ],
      "@101/motion": [
        "../../packages/motion/src/index.ts"
      ],
      "@101/pairing": [
        "../../packages/pairing/src/index.ts"
      ],
      "@101/protocol": [
        "../../packages/protocol/src/index.ts"
      ],
      "@101/connect": [
        "../../packages/connect/src/index.ts"
      ],
      "@101/device-model": [
        "../../packages/device-model/src/index.ts"
      ],
      "@101/device-runtime": [
        "../../packages/device-runtime/src/index.ts"
      ],
      "@101/device-web": [
        "../../packages/device-web/src/index.ts"
      ],
      "@101/transport-webrtc": [
        "../../packages/transport-webrtc/src/index.ts"
      ]
    }
  },
  "include": [
    "App.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "modules/**/*.ts"
  ]
}
