{
  "name": "@101/controller-native",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "test": "node --experimental-strip-types --test src/pairing-code.test.ts src/watch-controller.test.ts src/motion-controller.test.ts src/controller-speaker.test.ts src/controller-runtime-gates.test.ts src/native-webrtc-codec.test.ts",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "export": "expo export --platform all --output-dir dist"
  },
  "dependencies": {
    "@101/adapter-watch": "0.1.0",
    "@101/input": "0.1.0",
    "@101/link-controller": "0.1.0",
    "@101/motion": "0.1.0",
    "@101/pairing": "0.1.0",
    "@101/protocol": "0.1.0",
    "base64-js": "1.5.1",
    "expo": "57.0.12",
    "expo-audio": "~57.0.4",
    "expo-build-properties": "57.0.10",
    "expo-camera": "57.0.3",
    "expo-clipboard": "57.0.1",
    "expo-crypto": "57.0.1",
    "expo-haptics": "57.0.1",
    "expo-secure-store": "57.0.1",
    "expo-sensors": "57.0.2",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.2",
    "pako": "3.0.1",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-webrtc": "124.0.8"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "expo-dev-client": "57.0.11",
    "expo-doctor": "1.20.1",
    "typescript": "6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-webrtc"
        ]
      }
    }
  }
}
